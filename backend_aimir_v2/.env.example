# === База данных ===
DATABASE_URL=postgresql://user:password@localhost:5432/analytics_app

# === JWT ===
JWT_SECRET=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# === SMTP (подтверждения по e-mail) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# === Хранилище документов / гости ===
DOCUMENTS_DIR=./storage/documents
GUEST_TTL_DAYS=7

# === OpenAI ===
OPENAI_API_KEY_1=sk-proj-...
OPENAI_API_KEY_2=sk-proj-...
OPENAI_API_KEY_3=sk-proj-...
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_TOKENS=4096

# === Разбиение текста ===
ANALYSIS_CHUNK_CHARS=10000
ANALYSIS_CHUNK_OVERLAP=800
ANALYSIS_CONCURRENCY=3
MAX_TOKENS_PER_CHUNK=50000

# === Цены (в рублях) ===
REQUEST_PRICE=39
SUB_PRICE_MONTH=450
SUB_PRICE_6M=1750
SUB_PRICE_YEAR=3150

# === Google OAuth ===
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# === T-Банк (платежи) ===
TBANK_TERMINAL_KEY=your_terminal_key
TBANK_PASSWORD=your_tbank_password
TBANK_API=https://securepay.tinkoff.ru/v2
TBANK_NOTIFY_URL=https://yourdomain.com/api/billing/webhook
TBANK_SUCCESS_URL=https://yourdomain.com/
TBANK_FAIL_URL=https://yourdomain.com/
TBANK_WEBHOOK_SKIP_TOKEN=true

# === Прокси (опционально) ===
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=http://user:pass@host:port

# === Telegram (уведомления, опционально) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# === Публичный URL сервера ===
PUBLIC_BASE_URL=https://yourdomain.com/api

# === Yandex Metrika (опционально) ===
# YANDEX_METRIKA_TOKEN=your_token

# === Промпты (оставить как есть — заполнены в коде) ===
PROMPT_IDENTIFY_PARTIES=
PROMPT_FULL_ANALYSIS=
MERGE_PROMPT=
PROMPT_FULL_ANALYSIS_V2=
MERGE_PROMPT_V2=
